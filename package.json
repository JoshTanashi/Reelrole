{
  "name": "reelrole",
  "version": "0.0.0",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc && tsc -p tsconfig.scripts.json",
    "icons": "node scripts/make-icons.mjs",
    "ingest": "NODE_USE_ENV_PROXY=1 node scripts/ingest/build-catalogue.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JoshTanashi/Reelrole.git"
  },
  "bugs": {
    "url": "https://github.com/JoshTanashi/Reelrole/issues"
  },
  "homepage": "https://github.com/JoshTanashi/Reelrole#readme",
  "dependencies": {
    "@capacitor/core": "^8.6.0",
    "@capacitor/haptics": "^8.0.2",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "motion": "^14.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.2.1",
    "blurhash": "^2.0.5",
    "jsdom": "^31.0.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  },
  "private": true,
  "type": "module"
}
