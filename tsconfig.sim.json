{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node",
      "vite/client"
    ]
  },
  "include": [
    "scripts/sim-find.ts",
    "src/engine",
    "src/data"
  ],
  "exclude": [
    "**/*.test.ts"
  ]
}